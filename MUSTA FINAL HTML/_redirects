# Force www to non-www
https://www.djmusta.com/* https://djmusta.com/:splat 301

# Force pages.dev to custom domain
https://djmusta.pages.dev/* https://djmusta.com/:splat 301

# Sub-pages - explicit HTML file routes (fix redirect loop)
/gospel.html /gospel.html 200
/gospel /gospel.html 200
/nonstops.html /nonstops.html 200
/nonstops /nonstops.html 200
/top-songs.html /top-songs.html 200
/top-songs /top-songs.html 200
/top-artists.html /top-artists.html 200
/top-artists /top-artists.html 200
/new-music.html /new-music.html 200
/new-music /new-music.html 200
/404.html /404.html 200
/offline.html /offline.html 200

# Sitemap — proxy to backend so Google gets live song list
/sitemap.xml https://mustabackend-nenb.onrender.com/sitemap.xml 200

# Song pretty URLs - serve index.html so song-router.js can handle them
/song/* /index.html 200

# Fallback - all other paths serve index.html (SPA)
/* /index.html 200
